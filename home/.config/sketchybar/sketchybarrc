#!/usr/bin/env bash
# SketchyBar stands in for the macOS menu bar, which configuration.nix hides
# (`_HIHideMenuBar = true`).
#
# home.nix links this directory to ~/.config/sketchybar and starts sketchybar
# from a launchd agent, so edit the files here, not there. After an edit run
# `sketchybar --reload`; no rebuild is needed.
#
# The layout is deliberately sparse: the workspace you are on, and three
# numbers about the machine. Anything else is a thing to read instead of a
# thing to glance at.
#
# AeroSpace is not a macOS Spaces manager, so sketchybar's built-in
# `space_change` event never fires for it. aerospace.toml's
# exec-on-workspace-change triggers the custom `aerospace_workspace_change`
# event declared below instead.
#
# No battery item: this is a Mac mini (Mac16,10) and `pmset -g batt` reports no
# battery at all, so the item would be permanently blank. Add one here if this
# config ever moves to a laptop.
#
# Full option list: https://felixkratz.github.io/SketchyBar/config/bar

# sketchybar exports CONFIG_DIR - the directory it loaded this file from - and
# the plugin scripts inherit it, so nothing here has to know where it lives.
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGINS="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# The one font this machine installs, and the one with the glyphs the bar needs.
# The two icons below are Hack Nerd Font's `fa-memory` (U+EFC5, a RAM stick)
# and `oct-cpu` (U+F4BC, a square chip). They are picked to be told apart at
# 14px: every other "memory" glyph in this font is a chip too, and next to the
# CPU icon the pair was unreadable.
FONT="Hack Nerd Font"

# A floating bar, not a flush one: margin and y_offset both 16 put the same
# gap between the bar and the screen edge that aerospace.toml puts between a
# window and the screen edge, so the bar reads as the first tile rather than
# as chrome bolted to the top.
#
# That stacks up: 16 above the bar + 32 of bar + 16 below it, which is why
# aerospace.toml's gaps.outer.top is 64. Change the height or either offset
# here and change that number too.
#
# blur_radius plus the alpha in $BAR are what make this the same material as a
# WezTerm window (window_background_opacity 0.8, macos_window_background_blur
# 50). The blur is only visible because $BAR is translucent; at full alpha it
# would be wasted work.
sketchybar --bar \
	height=32 \
	position=top \
	sticky=on \
	margin=16 \
	y_offset=16 \
	corner_radius=9 \
	blur_radius=50 \
	padding_left=6 \
	padding_right=6 \
	color="$BAR" \
	shadow=off

sketchybar --default \
	icon.font="$FONT:Bold:14.0" \
	icon.color="$TEXT" \
	icon.padding_left=6 \
	icon.padding_right=3 \
	label.font="$FONT:Regular:13.0" \
	label.color="$TEXT" \
	label.padding_left=0 \
	label.padding_right=6 \
	background.drawing=off \
	padding_left=2 \
	padding_right=2

# --- left: the focused AeroSpace workspace, and nothing else ---------------
#
# Only the workspace that has focus is drawn. The other eight carry no
# information you act on - AeroSpace's alt-1..9 bindings are absolute, so a row
# of dim numbers is a legend for keys you already know.

sketchybar --add event aerospace_workspace_change

sketchybar --add item workspace left \
	--subscribe workspace aerospace_workspace_change \
	--set workspace \
		icon.drawing=off \
		label.font="$FONT:Bold:13.0" \
		label.color="$PILL_TEXT" \
		label.padding_left=7 \
		label.padding_right=7 \
		background.color="$FOCUS" \
		background.corner_radius=5 \
		background.height=20 \
		background.drawing=on \
		script="$PLUGINS/aerospace.sh"

# --- right: added right to left, so this reads memory, cpu, volume ---------

sketchybar --add item volume right \
	--subscribe volume volume_change \
	--set volume \
		icon.color="$TEXT" \
		label.color="$TEXT" \
		script="$PLUGINS/volume.sh"

sketchybar --add item cpu right \
	--set cpu \
		update_freq=3 \
		icon="" \
		icon.color="$TEXT" \
		label.color="$TEXT" \
		script="$PLUGINS/cpu.sh"

sketchybar --add item memory right \
	--set memory \
		update_freq=15 \
		icon="" \
		icon.color="$TEXT" \
		label.color="$TEXT" \
		script="$PLUGINS/memory.sh"

# Paint the initial state: every script above runs once here, which is also
# what fills the workspace pill before AeroSpace has fired its first event.
sketchybar --update
